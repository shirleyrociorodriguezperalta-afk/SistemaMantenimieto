@model IEnumerable<SistemaMantenimiento.Entities.Equipo>

@{
    ViewData["Title"] = "Gestión de Equipos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-laptop me-2"></i>Gestión de Equipos</h2>
    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Nuevo Equipo
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <table id="tablaEquipos" class="table table-striped table-hover align-middle w-100">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Código Activo</th>
                    <th>Nombre</th>
                    <th>Ubicación</th>
                    <th>Estado Operativo</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var equipo in Model)
                {
                    <tr>
                        <td>@equipo.IdEquipo</td>
                        <td><span class="fw-bold">@equipo.CodigoActivo</span></td>
                        <td>@equipo.Nombre</td>
                        <td>@equipo.Ubicacion</td>
                        <td>
                            @if (equipo.EstadoOperativo == "Operativo")
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i> Operativo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="bi bi-tools me-1"></i> @equipo.EstadoOperativo
                                </span>
                            }
                        </td>
                        <td class="text-center text-nowrap">
                            <!-- 1. Ver Historial -->
                            <a asp-action="Historial"
                               asp-route-id="@equipo.IdEquipo"
                               class="btn btn-sm btn-outline-info"
                               title="Ver Historial de Mantenimientos">
                                <i class="bi bi-clock-history"></i>
                            </a>

                            <!-- 2. Asignar Plan -->
                            <a asp-controller="PlanMantenimiento"
                               asp-action="Crear"
                               asp-route-idEquipo="@equipo.IdEquipo"
                               class="btn btn-sm btn-outline-success"
                               title="Asignar Plan de Mantenimiento">
                                <i class="bi bi-calendar-plus"></i>
                            </a>

                            <!-- 3. Editar Equipo -->
                            <a asp-action="Editar"
                               asp-route-id="@equipo.IdEquipo"
                               class="btn btn-sm btn-outline-primary"
                               title="Editar Equipo">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <!-- 4. Eliminar Equipo -->
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    onclick="confirmarEliminacion(@equipo.IdEquipo)"
                                    title="Eliminar Equipo">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaEquipos').DataTable({
                "language": {
                    "url": "https://cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json"
                },
                "pageLength": 10,
                "responsive": true,
                "order": [[0, "desc"]],
                "dom": '<"d-flex justify-content-between align-items-center mb-3"Bf>rt<"d-flex justify-content-between align-items-center mt-3"lip>',
                "buttons": [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="bi bi-file-earmark-excel me-1"></i> Excel',
                        className: 'btn btn-success btn-sm me-1',
                        title: 'Inventario_Equipos_Universitarios',
                        exportOptions: {
                            columns: [0, 1, 2, 3, 4]
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="bi bi-file-earmark-pdf me-1"></i> PDF',
                        className: 'btn btn-danger btn-sm me-1',
                        title: 'Inventario General de Equipos',
                        exportOptions: {
                            columns: [0, 1, 2, 3, 4]
                        }
                    },
                    {
                        extend: 'print',
                        text: '<i class="bi bi-printer me-1"></i> Imprimir',
                        className: 'btn btn-secondary btn-sm',
                        exportOptions: {
                            columns: [0, 1, 2, 3, 4]
                        }
                    }
                ]
            });
        });

        function confirmarEliminacion(id) {
            Swal.fire({
                title: '¿Estás seguro?',
                text: "Esta acción eliminará el equipo del registro.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/Equipo/Eliminar/' + id;
                }
            });
        }
    </script>
}