@model IEnumerable<SistemaMantenimiento.Entities.Mantenimiento>

@{
    var equipo = ViewBag.Equipo as SistemaMantenimiento.Entities.Equipo;
    ViewData["Title"] = $"Historial de Mantenimientos - {equipo?.Nombre}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-clock-history me-2"></i>Historial de Mantenimientos</h2>
        <h5 class="text-muted mb-0">
            Equipo: <span class="fw-bold text-dark">@(equipo?.Nombre)</span>
            <span class="badge bg-secondary ms-2">Cód: @(equipo?.CodigoActivo ?? "S/C")</span>
        </h5>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Volver a Equipos
    </a>
</div>

<!-- Tarjetas de Resumen Rápido -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-light p-3">
            <div class="d-flex align-items-center">
                <div class="fs-1 text-primary me-3"><i class="bi bi-journal-check"></i></div>
                <div>
                    <h6 class="text-muted mb-0">Total Intervenciones</h6>
                    <h3 class="fw-bold mb-0">@Model.Count()</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-light p-3">
            <div class="d-flex align-items-center">
                <div class="fs-1 text-success me-3"><i class="bi bi-check-circle"></i></div>
                <div>
                    <h6 class="text-muted mb-0">Mantenimientos Realizados</h6>
                    <h3 class="fw-bold mb-0">@Model.Count(m => m.Estado == "Realizado")</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-light p-3">
            <div class="d-flex align-items-center">
                <div class="fs-1 text-warning me-3"><i class="bi bi-geo-alt"></i></div>
                <div>
                    <h6 class="text-muted mb-0">Ubicación Actual</h6>
                    <h5 class="fw-bold mb-0">@(equipo?.Ubicacion)</h5>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabla del Historial -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fw-bold text-secondary">
            <i class="bi bi-list-stars me-2"></i>Registro Cronológico
        </h5>
    </div>
    <div class="card-body">
        <table id="tablaHistorial" class="table table-striped table-hover align-middle w-100">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Fecha Programada</th>
                    <th>Fecha Realizada</th>
                    <th>Técnico Responsable</th>
                    <th>Estado</th>
                    <th>Observaciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdMantenimiento</td>
                        <td>@item.FechaProgramada.ToString("dd/MM/yyyy")</td>
                        <td>
                            @(item.FechaRealizada.HasValue ? item.FechaRealizada.Value.ToString("dd/MM/yyyy") : "-")
                        </td>
                        <td>@(item.Tecnico?.Nombre ?? "Sin Asignar")</td>
                        <td>
                            @if (string.Equals(item.Estado, "REALIZADO", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Realizado</span>
                            }
                            else if (string.Equals(item.Estado, "VENCIDO", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i> Vencido</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i> @item.Estado</span>
                            }
                        </td>
                        <td>
                            <small class="text-muted">@(string.IsNullOrWhiteSpace(item.Observaciones) ? "Sin observaciones" : item.Observaciones)</small>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#tablaHistorial').DataTable({
                "language": {
                    "url": "https://cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json"
                },
                "pageLength": 10,
                "responsive": true,
                "order": [[1, "desc"]],
                "dom": '<"d-flex justify-content-between align-items-center mb-3"Bf>rt<"d-flex justify-content-between align-items-center mt-3"lip>',
                "buttons": [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="bi bi-file-earmark-excel me-1"></i> Excel',
                        className: 'btn btn-success btn-sm me-1',
                        title: 'Historial_Mantenimiento_@(equipo?.CodigoActivo)'
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="bi bi-file-earmark-pdf me-1"></i> PDF',
                        className: 'btn btn-danger btn-sm me-1',
                        title: 'Historial de Mantenimiento - @(equipo?.Nombre)'
                    },
                    {
                        extend: 'print',
                        text: '<i class="bi bi-printer me-1"></i> Imprimir',
                        className: 'btn btn-secondary btn-sm'
                    }
                ]
            });
        });
    </script>
}