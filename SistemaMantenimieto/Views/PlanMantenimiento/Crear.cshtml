@model SistemaMantenimiento.Models.PlanMantenimientoViewModel

@{
    ViewData["Title"] = "Asignar Plan de Mantenimiento";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0 fs-5"><i class="bi bi-calendar-check me-2"></i>Asignar Plan de Mantenimiento</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <!-- Selección de Equipo -->
                <div class="mb-3">
                    <label asp-for="IdEquipo" class="form-label fw-bold">Equipo</label>
                    <select asp-for="IdEquipo" asp-items="ViewBag.IdEquipo" class="form-select">
                        <option value="">-- Seleccione un Equipo Operativo --</option>
                    </select>
                    <span asp-validation-for="IdEquipo" class="text-danger small"></span>
                </div>

                <!-- Descripción de la Tarea -->
                <div class="mb-3">
                    <label asp-for="DescripcionTarea" class="form-label fw-bold">Descripción de Tareas Preventivas</label>
                    <input asp-for="DescripcionTarea" class="form-control" placeholder="Ej: Limpieza de filtros, calibración y revisión técnica" />
                    <span asp-validation-for="DescripcionTarea" class="text-danger small"></span>
                </div>

                <!-- Frecuencia en Días -->
                <div class="mb-3">
                    <label asp-for="FrecuenciaDias" class="form-label fw-bold">Frecuencia de Mantenimiento (Días)</label>
                    <input asp-for="FrecuenciaDias" class="form-control" type="number" placeholder="Ej: 30 (mensual), 90 (trimestral)" />
                    <span asp-validation-for="FrecuenciaDias" class="text-danger small"></span>
                </div>

                <!-- Fecha de Inicio -->
                <div class="mb-3">
                    <label asp-for="FechaPrimerMantenimiento" class="form-label fw-bold">Fecha del Primer Mantenimiento</label>
                    <input asp-for="FechaPrimerMantenimiento" class="form-control" type="date" />
                    <span asp-validation-for="FechaPrimerMantenimiento" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-2 border-top">
                    <a asp-controller="Mantenimiento" asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-plus-circle me-1"></i> Guardar y Programar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}