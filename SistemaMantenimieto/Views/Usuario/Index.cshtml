@model IEnumerable<SistemaMantenimiento.Entities.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios y Accesos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-shield-lock me-2"></i>Gestión de Usuarios del Sistema</h2>
    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-person-plus-fill me-1"></i> Registrar Nuevo Usuario
    </a>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body">
        <table id="tablaUsuarios" class="table table-striped table-hover align-middle w-100">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre Completo</th>
                    <th>Usuario</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.IdUsuario</td>
                        <td class="fw-bold">@user.NombreCompleto</td>
                        <td><code>@user.Username</code></td>
                        <td>
                            @if (user.Rol == "Administrador")
                            {
                                <span class="badge bg-danger"><i class="bi bi-shield-fill me-1"></i> Administrador</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark"><i class="bi bi-person-badge me-1"></i> Técnico</span>
                            }
                        </td>
                        <td>
                            @if (user.Activo == 1)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-center">
                            <form asp-action="CambiarEstado" asp-route-id="@user.IdUsuario" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                @if (user.Activo == 1)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Desactivar acceso">
                                        <i class="bi bi-person-x-fill"></i> Desactivar
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Activar acceso">
                                        <i class="bi bi-person-check-fill"></i> Activar
                                    </button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#tablaUsuarios').DataTable({
                "language": {
                    "url": "https://cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json"
                }
            });
        });
    </script>
}