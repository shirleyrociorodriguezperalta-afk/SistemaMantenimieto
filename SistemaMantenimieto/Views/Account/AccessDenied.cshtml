@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4">
                <div class="card-body">
                    <i class="bi bi-shield-lock-fill text-danger display-1 mb-3"></i>
                    <h2 class="fw-bold text-dark mb-2">Acceso Restringido</h2>
                    <p class="text-muted mb-4">
                        No tienes los permisos necesarios (Rol Administrador) para acceder a este módulo.
                    </p>
                    <a asp-controller="Mantenimiento" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-arrow-left me-1"></i> Volver al Tablero Principal
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>