@model SistemaMantenimiento.Models.RegistrarMantenimientoViewModel

@{
    ViewData["Title"] = "Registrar Mantenimiento Ejecutado";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0 fs-5"><i class="bi bi-tools me-2"></i>Registrar Mantenimiento Realizado</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Registrar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdMantenimiento" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                <!-- Fecha Realizada -->
                <div class="mb-3">
                    <label asp-for="FechaRealizada" class="form-label fw-bold">Fecha Realizada</label>
                    <input asp-for="FechaRealizada" class="form-control" type="date" />
                    <span asp-validation-for="FechaRealizada" class="text-danger small"></span>
                </div>

                <!-- Técnico Responsable (Único y Unificado) -->
                <div class="mb-3">
                    <label asp-for="IdTecnico" class="form-label fw-bold">Técnico Responsable</label>
                    <select asp-for="IdTecnico" asp-items="ViewBag.Tecnicos" class="form-select">
                        <option value="">-- Seleccionar Técnico --</option>
                    </select>
                    <span asp-validation-for="IdTecnico" class="text-danger small"></span>
                </div>

                <!-- Observaciones -->
                <div class="mb-3">
                    <label asp-for="Observaciones" class="form-label fw-bold">Observaciones / Detalles</label>
                    <textarea asp-for="Observaciones" class="form-control" rows="3" placeholder="Detalle el trabajo realizado, repuestos o notas relevantes..."></textarea>
                    <span asp-validation-for="Observaciones" class="text-danger small"></span>
                </div>

                <!-- Botones de Acción -->
                <div class="d-flex justify-content-between align-items-center mt-4 pt-2 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-success px-4 shadow-sm">
                        <i class="bi bi-check-circle me-1"></i> Guardar Mantenimiento
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}